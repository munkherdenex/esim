NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://holbo:holbo@localhost:5432/holbo
ESIM_PROVIDER=mock
# Set ESIM_PROVIDER=esim-access and provide both values from eSIM Access.
# ESIM_ACCESS_CODE=
# ESIM_ACCESS_SECRET=
# Configure these values before running package sync; no exchange-rate assumption is made.
# USD_TO_MNT_RATE=
# DEFAULT_MARKUP_PERCENT=
# ROUNDING_STEP_MNT=
# QPay defaults to mock so local checkout works without merchant credentials.
QPAY_PROVIDER=mock
QPAY_ENVIRONMENT=sandbox
# Required for QPAY_PROVIDER=qpay:
# QPAY_CLIENT_ID=
# QPAY_CLIENT_SECRET=
# Use the invoice profile values assigned to this merchant by QPay.
# QPAY_INVOICE_PROFILE_JSON=
# Configure the eSIM Access webhook in your provider account using:
# https://your-public-host/api/webhooks/esim?secret=<same-value>
# Use a randomly generated value with at least 32 characters.
# ESIM_WEBHOOK_SECRET=
# Optional delivery email (required together):
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# Required with Resend: a random 32-byte key encoded as 64 hex characters.
# ORDER_TOKEN_ENCRYPTION_KEY=
