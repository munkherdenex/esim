NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://holbo:holbo@localhost:5432/holbo
ESIM_PROVIDER=mock
# Set ESIM_PROVIDER=esim-access and provide ESIM_ACCESS_CODE to use the live API.
# Configure these values before running package sync; no exchange-rate assumption is made.
# USD_TO_MNT_RATE=
# DEFAULT_MARKUP_PERCENT=
# ROUNDING_STEP_MNT=
# QPay defaults to mock so local checkout works without merchant credentials.
QPAY_PROVIDER=mock
QPAY_ENVIRONMENT=sandbox
# Required for QPAY_PROVIDER=qpay:
# QPAY_CLIENT_ID=
# QPAY_CLIENT_SECRET=
# Use the invoice profile values assigned to this merchant by QPay.
# QPAY_INVOICE_PROFILE_JSON=
